<section class="container secao">
    <div class="titulo-secao">
        <span class="etiqueta">FAÇA PARTE</span>
        <h1>Crie sua conta</h1>
        <p>Cadastre-se para finalizar compras e acompanhar seus pedidos.</p>
    </div>
    <% if (erro) { %><p class="mensagem-erro" role="alert"><%= erro %></p><% } %>
    <form action="/cliente/cadastro" method="POST" class="formulario">
        <input type="hidden" name="proxima" value="<%= proxima %>">
        <label for="nome">Nome completo</label>
        <input id="nome" name="nome" value="<%= dados.nome || '' %>" maxlength="120" autocomplete="name" required>
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" value="<%= dados.email || '' %>" autocomplete="email" required>
        <label for="telefone">Telefone (opcional)</label>
        <input id="telefone" name="telefone" type="tel" value="<%= dados.telefone || '' %>" autocomplete="tel">
        <label for="senha">Senha (mínimo de 8 caracteres)</label>
        <input id="senha" name="senha" type="password" minlength="8" autocomplete="new-password" required>
        <button class="botao" type="submit">Criar conta</button>
    </form>
    <p>Já possui uma conta? <a href="/cliente/login?proxima=<%= encodeURIComponent(proxima) %>">Entrar</a></p>
</section>
