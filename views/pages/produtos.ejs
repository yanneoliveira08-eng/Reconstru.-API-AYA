<section class="container secao">
    <div class="titulo-secao">
        <span class="etiqueta">EXPLORE A LOJA</span>
        <h1>Nosso catálogo</h1>
        <p>Encontre obras e materiais para sua jornada criativa.</p>
    </div>

    <div class="barra-pesquisa">
        <label for="pesquisa">Pesquisar produtos</label>
        <input
            type="search"
            id="pesquisa"
            placeholder="Ex.: quadro, livro, pincel..."
        >
    </div>

    <div class="grade-produtos">
        <% produtos.forEach(produto => { %>
            <article
                class="produto-card item-pesquisa"
                data-nome="<%= produto.nome.toLowerCase() %>"
                data-categoria="<%= produto.categoria.toLowerCase() %>"
            >
                <a href="/produtos/<%= produto.id %>">
                    <img
                        src="<%= produto.imagem || '/img/sem-imagem.png' %>"
                        alt="<%= produto.nome %>"
                        loading="lazy"
                    >
                </a>

                <div class="produto-info">
                    <span class="categoria"><%= produto.categoria %></span>
                    <h2><%= produto.nome %></h2>
                    <p><%= produto.descricao %></p>

                    <strong>
                        <%= produto.preco.toLocaleString('pt-BR', {
                            style: 'currency',
                            currency: 'BRL'
                        }) %>
                    </strong>

                    <p>
                        <%= produto.estoque > 0
                            ? 'Disponível em estoque'
                            : 'Produto indisponível' %>
                    </p>

                    <a class="botao botao-secundario"
                       href="/produtos/<%= produto.id %>">
                        Ver detalhes
                    </a>
                </div>
            </article>
        <% }) %>
    </div>

    <p id="sem-resultados" hidden>
        Nenhum produto encontrado para essa pesquisa.
    </p>
</section>
