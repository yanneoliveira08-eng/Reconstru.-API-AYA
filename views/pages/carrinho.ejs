<section class="container secao">
    <div class="titulo-secao">
        <span class="etiqueta">SUA SELEÇÃO</span>
        <h1>Meu carrinho</h1>
        <p>Confira os produtos escolhidos antes de continuar.</p>
    </div>

    <% if (itens.length === 0) { %>
        <p>Seu carrinho está vazio.</p>
        <a href="/produtos" class="botao">Explorar produtos</a>
    <% } else { %>
        <div class="lista-carrinho">
            <% itens.forEach(item => { %>
                <article class="item-carrinho">
                    <img
                        src="<%= item.imagem || '/img/sem-imagem.png' %>"
                        alt="<%= item.nome %>"
                    >

                    <div>
                        <h2><%= item.nome %></h2>
                        <p>Quantidade: <%= item.quantidade %></p>
                        <p>
                            Preço unitário:
                            <%= item.preco.toLocaleString('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            }) %>
                        </p>
                        <strong>
                            Subtotal:
                            <%= item.subtotal.toLocaleString('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            }) %>
                        </strong>

                        <form
                            action="/carrinho/remover/<%= item.id %>"
                            method="POST"
                        >
                            <button class="botao botao-perigo" type="submit">
                                Remover
                            </button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>

        <div class="resumo-carrinho">
            <h2>
                Total:
                <%= total.toLocaleString('pt-BR', {
                    style: 'currency',
                    currency: 'BRL'
                }) %>
            </h2>

            <form action="/pedidos/finalizar" method="POST">
                <label for="cliente">Nome do cliente</label>
                <input id="cliente" name="cliente" required maxlength="120">

                <label for="email">E-mail</label>
                <input id="email" name="email" type="email" required maxlength="254">

                <button class="botao" type="submit">
                    Finalizar pedido
                </button>
            </form>
        </div>
    <% } %>
</section>
